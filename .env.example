# ==============================================================================
# Local SLM Assistant & Benchmarking Suite - Environment Configuration
# ==============================================================================

# Local Ollama daemon host address.
# Format: host:port, 0.0.0.0, or http://127.0.0.1:11434
OLLAMA_HOST=http://127.0.0.1:11434

# Default Small Language Model (SLM) tag for assistant chat and testing
SLM_DEFAULT_MODEL=llama3.2:3b

# Default keep-alive duration for loaded models in RAM/VRAM
# E.g. "5m", "10m", "1h", or "0" (to immediately evict model after generation)
SLM_KEEP_ALIVE=10m

# Default context window size (tokens)
SLM_NUM_CTX=4096

# Per-request HTTP timeout in seconds (includes long prefill / generation phases)
SLM_TIMEOUT_S=600
